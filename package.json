{
  "name": "strategy-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "python -m uvicorn backend.app.main:app --reload --app-dir .",
    "dev:all": "powershell -ExecutionPolicy Bypass -File .\\start-dev.ps1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cloudflare:login": "npx -y wrangler login",
    "cloudflare:kv:create": "npx -y wrangler kv namespace create STRATEGY_LAB_STATE",
    "dev:cloudflare": "npm run build && npx -y wrangler pages dev dist --kv STRATEGY_LAB_STATE",
    "deploy:cloudflare": "npm run build && npx -y wrangler pages deploy dist --project-name strategy-lab",
    "deploy:cloudflare:preview": "npm run build && npx -y wrangler pages deploy dist --project-name strategy-lab --branch=preview",
    "deploy:vercel": "vercel",
    "deploy:vercel:prod": "vercel --prod"
  },
  "dependencies": {
    "hyparquet": "^1.25.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vercel": "^50.35.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.1"
  }
}
