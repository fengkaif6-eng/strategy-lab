# Leave this unset when front-end and back-end are mounted under the same
# CloudBase HTTP access service domain and the API is available at /api.
#
# Set it only if the static site needs to call a separate CloudBase Run domain.
#
# Example:
# VITE_MARKET_API_BASE_URL=https://<your-cloudbase-run-domain>

# Shared state for multi-instance consistency:
# if configured, app state and market snapshots are stored in one MongoDB collection,
# so all users/instances read the same data.
#
# Shared store is strict by default:
# MARKET_SHARED_STORE_REQUIRED defaults to 1.
# You must provide a reachable Mongo URI for production.
# (Only set MARKET_SHARED_STORE_REQUIRED=0 for local temporary debugging.)
#
# MARKET_SHARED_STORE_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# MARKET_SHARED_STORE_MONGODB_DB=strategy_lab
# MARKET_SHARED_STORE_MONGODB_COLLECTION=shared_kv
# MARKET_SHARED_STORE_REQUIRED=1
